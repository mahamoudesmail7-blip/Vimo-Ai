# --- required ---
DATABASE_URL=postgresql://user:pass@host:5432/vimo
JWT_SECRET=change-me-to-a-long-random-string
FAL_KEY=                      # fal.ai API key — makes the videos (https://fal.ai/dashboard/keys)

# --- recommended ---
ADMIN_EMAILS=you@example.com   # sign up with this email and the account is the admin
# ADMIN_RESET_PASSWORD=          # forgot the admin password? set it, redeploy, log in, then delete it
OPENAI_API_KEY=               # writes the Egyptian script from the product photo; without it a template script is used
VODAFONE_CASH_NUMBER=01113878767   # shown to customers on the top-up page
SUPPORT_WHATSAPP=+2010xxxxxxxx

# --- more video engines (optional; pick and price them on the admin "AI Engines" page) ---
# HIGGSFIELD_API_KEY=            # Higgsfield official API key id
# HIGGSFIELD_API_SECRET=         # and its secret (cloud.higgsfield.ai)
# GOOGLE_SERVICE_ACCOUNT_JSON=   # Vertex AI service account JSON (raw or base64) with the Vertex AI User role
# GOOGLE_CLOUD_PROJECT=          # defaults to the service account's project_id
# GOOGLE_CLOUD_LOCATION=us-central1
# PUBLIC_BASE_URL=https://your-app.up.railway.app   # Railway sets RAILWAY_PUBLIC_DOMAIN, used when this is empty
# VIMO_ENABLE_MOCK=1             # free fake engine (no real video) for local testing; also on with NODE_ENV=development
# VIMO_TTS_VOICE_MALE=Adam       # ElevenLabs voices for the voiceover mode
# VIMO_TTS_VOICE_FEMALE=Rachel

# --- optional tuning ---
# OPENAI_MODEL=gpt-4o-mini
# VIMO_VIDEO_MODE=ingredients   # like Google Flow Ingredients: clips from the first frame + product photo as references
# VIMO_VIDEO_MODEL=fal-ai/veo3.1/fast/image-to-video
# VIMO_KEYFRAME_MODEL=fal-ai/nano-banana-pro/edit   # "off" animates the raw product photo
# VIMO_SCRIPT_MODEL=anthropic/claude-sonnet-4.5      # script LLM on fal (used when OPENAI_API_KEY is empty)
# VIMO_MERGE_MODEL=fal-ai/ffmpeg-api/merge-videos
# VIMO_VIDEO_RESOLUTION=720p
# VIMO_CLIP_COUNT=3            # 3 clips x 8s = 24s
# VIMO_CLIP_SECONDS=8
# VIMO_COST_PER_SECOND_USD=0.15  # only for the admin's cost estimate
# VIMO_SIGNUP_BONUS=0           # free videos for a new account
# VIMO_PACKAGES=[{"key":"starter","videos":1,"priceEgp":350,"label":"تجربة"}]
# PORT=3000
