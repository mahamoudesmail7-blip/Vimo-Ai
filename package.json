{
  "name": "vimo-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Vimo AI — حوّل صورة منتجك لفيديو إعلاني بالذكاء الاصطناعي بلهجة مصرية",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "NODE_ENV=development node --env-file-if-exists=.env src/server.js",
    "start": "prisma migrate deploy && node src/server.js",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "admin:create": "node --env-file-if-exists=.env src/scripts/createAdmin.js",
    "test": "NODE_ENV=test node --test tests/*.test.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "ffmpeg-static": "^5.2.0",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^5.22.0",
    "zod": "^3.24.1"
  }
}
